# Canonical origin, without a path.
SITE_URL=https://mazat-transport.fr
# Enable only after closing publication blockers in todo.md.
PUBLICATION_READY=false

# Browser-visible Google Places key; restrict HTTP referrers and APIs in Google Cloud.
# Enable Maps JavaScript API and Places API (New). Leave empty for manual input.
GOOGLE_MAPS_API_KEY=

# Public, form-scoped token. It is embedded in the generated site; never use a private token.
FORGE_FORM_TOKEN=
