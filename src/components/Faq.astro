---
import { localFaqs } from '../content/faq';
import { fetchResource } from '../lib/forge';
const remote = await fetchResource('faqs');
const valid = remote?.every(f => typeof f.question === 'string' && !!f.question.trim() && typeof f.answer === 'string' && !!f.answer.trim());
if (remote?.length && !valid) console.warn('[Forge faqs] Invalid fields; using local FAQ.');
const faqs = valid && remote?.length ? [...remote].sort((a,b)=>Number(a.position || 0)-Number(b.position || 0)) as {question:string;answer:string}[] : localFaqs;
---
<section class="mx-auto grid w-11/12 max-w-7xl gap-10 py-16 md:w-5/6 md:grid-cols-3 md:gap-16 md:py-24" aria-labelledby="faq-title"><div><p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">Vos questions, nos réponses</p><h2 id="faq-title" class="mb-4 text-3xl font-bold md:text-4xl">Un départ bien préparé.</h2><p class="text-slate-600">Les repères pour avancer dans votre projet.</p></div><div class="md:col-span-2">{faqs.map(f=><details class="border-t border-slate-200 py-5 last:border-b"><summary class="cursor-pointer pr-4 font-bold">{f.question}</summary><p class="mt-4 text-sm text-slate-600">{f.answer}</p></details>)}</div></section>
