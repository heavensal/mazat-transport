---
import { offers } from '../content/offers';
const { full = false } = Astro.props;
---

<div
  class:list={[
    full
      ? 'grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'
      : 'grid grid-cols-1 overflow-hidden rounded-sm border border-slate-200 md:grid-cols-3 lg:grid-cols-5',
  ]}
>
  {offers.map((offer, i) => (
    <article
      id={full ? offer.id : undefined}
      class:list={[
        full
          ? 'flex min-h-full flex-col rounded-sm border border-slate-200 p-8'
          : 'relative flex flex-col border-b border-slate-200 bg-white p-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0',
        offer.id === 'standard' ? 'border-t-3 border-t-sky-700 bg-sky-50' : '',
      ]}
    >
      <span
        class="mb-8 text-4xl leading-none tracking-tight text-slate-600"
        aria-hidden="true"
      >
        0{i + 1}
      </span>
      <p class="mb-3 text-xs font-bold uppercase tracking-wide text-sky-700">
        {offer.tag}
      </p>
      <h3 class="mb-3 text-2xl font-bold">{offer.name}</h3>
      <p class="text-sm text-slate-600">{offer.description}</p>
      {full && (
        <>
          <ul class="mb-6 list-disc pl-5 text-sm">
            {offer.included.map((item) => (
              <li class="pb-2">{item}</li>
            ))}
          </ul>
          <div class="mb-6 text-sm">
            <strong>Votre préparation</strong>
            <p class="mb-4 mt-1">{offer.preparation}</p>
            <strong>À définir ensemble</strong>
            <p class="mt-1">{offer.options}</p>
          </div>
        </>
      )}
      <a
        class:list={[
          full
            ? 'mt-auto inline-flex min-h-12 items-center justify-center rounded-sm border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 no-underline hover:bg-slate-100'
            : 'mt-auto pt-6 text-sm font-bold underline decoration-slate-300 underline-offset-4 hover:text-red-800',
        ]}
        href={full ? `/devis/?formule=${offer.id}` : `/formules/#${offer.id}`}
      >
        {full ? 'Recevoir un devis' : 'Découvrir la formule'}
      </a>
    </article>
  ))}
</div>
