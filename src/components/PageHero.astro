---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { RegisteredContentPage } from '../site/pages';

interface Props {
  page: RegisteredContentPage;
  image?: ImageMetadata;
}

const { page, image } = Astro.props;
---

<section
  class:list={[
    'bg-slate-950 py-16 text-white md:py-20',
    image && 'relative isolate overflow-hidden',
  ]}
>
  {
    image && (
      <Image
        src={image}
        alt=""
        aria-hidden="true"
        width={1152}
        height={768}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )
  }
  {image && <div class="absolute inset-0 bg-slate-950/75" aria-hidden="true" />}
  <div class="relative mx-auto w-11/12 max-w-7xl md:w-5/6">
    <nav
      class:list={['mb-8 text-sm', image ? 'text-slate-100' : 'text-slate-300']}
      aria-label="Fil d’Ariane"
    >
      <a class="underline" href="/">
        Accueil
      </a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{page.eyebrow}</span>
    </nav>
    <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-200">
      {page.eyebrow}
    </p>
    <h1 class="mb-6 max-w-4xl text-4xl font-extrabold leading-tight md:text-6xl">
      {page.heading.split('\n').map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </h1>
    <p class:list={['max-w-3xl text-lg', image ? 'text-white' : 'text-slate-300']}>
      {page.intro}
    </p>
  </div>
</section>
