---
import AddressAutocomplete from './AddressAutocomplete.astro';
import { offers } from '../content/offers';
import { business } from '../site/config';

const forgeFormToken = import.meta.env.FORGE_FORM_TOKEN ?? '';
---

<div class="grid gap-10 md:grid-cols-3">
  <aside class="md:sticky md:top-8 md:self-start">
    <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
      Un devis vraiment adapté
    </p>
    <h2 class="mb-5 text-3xl font-bold">
      Chaque détail
      <br />
      compte.
    </h2>
    <p class="mb-4 text-slate-600">
      Les accès, le volume et les prestations nous aident à comprendre votre
      projet.
    </p>
    <p>Vous préférez en parler directement ?</p>
    <a
      class="font-bold underline decoration-slate-300 underline-offset-4"
      href={business.phoneHref}
    >
      {business.phone}
    </a>
    <p class="mt-8 border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-sm text-slate-700">
      Votre demande est envoyée à MAZAT Transport depuis ce formulaire après
      votre validation.
    </p>
  </aside>
  <div class="rounded-sm border border-slate-200 p-5 md:col-span-2 md:p-8">
    <noscript>
      <p class="border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-slate-700">
        Pour préparer le récapitulatif, activez JavaScript ou contactez-nous
        directement par <a href={`mailto:${business.email}`}>email</a> ou par
        téléphone.
      </p>
    </noscript>
    <form id="quote-form" data-forge-form-token={forgeFormToken}>
      <p class="mb-5 text-sm text-slate-600">
        Les champs marqués * sont obligatoires. Après vérification, votre
        demande sera envoyée à MAZAT Transport. Pendant la saisie d’une adresse,
        les recherches d’adresse sont transmises à Google.
      </p>
      <p
        class="mb-5 text-sm font-bold text-sky-700"
        id="step-label"
        aria-live="polite"
      ></p>
      <progress
        class="quote-progress mb-8 h-2 w-full"
        id="step-progress"
        value="1"
        max="6"
        aria-label="Avancement de la demande"
        hidden
      ></progress>
      <fieldset class="mb-8 border-0 p-0" data-step="project">
        <legend class="mb-6 text-2xl font-bold" tabindex="-1">
          Votre projet
        </legend>
        <label>
          Votre projet *
          <select name="Type de projet" id="project-type" required>
            <option value="particulier">Déménagement particulier</option>
            <option value="entreprise">Transfert d’entreprise</option>
            <option value="export">Export international / maritime</option>
          </select>
        </label>
        <label>
          Formule souhaitée *
          <select name="Formule" id="offer" required>
            <option value="a-definir">À définir ensemble</option>
            {offers.map((o) => (
              <option value={o.id}>{o.name}</option>
            ))}
          </select>
        </label>
        <div class="form-row">
          <label>
            Date souhaitée
            <input type="date" name="Date souhaitée" id="moving-date" />
          </label>
          <label>
            Votre flexibilité *
            <select name="Flexibilité" id="flexibility" required>
              <option value="">Choisir</option>
              <option value="date-fixe">Date fixe (précisez la date)</option>
              <option value="flexible">Flexible autour de la date</option>
              <option value="a-definir">Date à définir ensemble</option>
            </select>
          </label>
        </div>
        <fieldset class="mb-5">
          <legend class="mb-3 text-sm font-semibold">
            Services complémentaires (plusieurs choix possibles)
          </legend>
          <div class="flex flex-wrap gap-3">
            {[
              ['stockage', 'Garde-meubles / stockage'],
              ['acces', 'Monte-meubles'],
              ['objets-lourds', 'Piano / objets lourds'],
              ['emballage', 'Emballage / cartons'],
              ['nettoyage', 'Nettoyage sur demande'],
              ['manutention', 'Manutention seule'],
            ].map(([id, title]) => (
              <label class="service-pill">
                <input
                  type="checkbox"
                  name="Services complémentaires"
                  value={title}
                  data-service={id}
                />
                <span class="service-pill-content">
                  <span class="service-pill-icon" aria-hidden="true">
                    <span class="service-pill-add">+</span>
                    <span class="service-pill-check">✓</span>
                  </span>
                  {title}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </fieldset>
      {['departure', 'arrival'].map((side, i) => (
        <fieldset class="mb-8 border-0 p-0" data-step={side}>
          <legend class="mb-6 text-2xl font-bold" tabindex="-1">
            {i === 0 ? 'Adresse de chargement' : 'Adresse de livraison'}
          </legend>
          <AddressAutocomplete side={side as 'departure' | 'arrival'} />
          <div class="form-row">
            <label>
              Type de logement / local *
              <select
                name={`${i === 0 ? 'Départ' : 'Arrivée'} — Type de local`}
                required
              >
                <option value="">Choisir</option>
                <option>Appartement</option>
                <option>Maison</option>
                <option>Bureaux / local professionnel</option>
                <option>Stockage / autre</option>
              </select>
            </label>
          </div>
          <div class="form-row">
            <label>
              Étage (0 = rez-de-chaussée) *
              <input
                type="number"
                name={`${i === 0 ? 'Départ' : 'Arrivée'} — Étage`}
                min="-5"
                max="150"
                required
              />
            </label>
            <label>
              Ascenseur *
              <select
                name={`${i === 0 ? 'Départ' : 'Arrivée'} — Ascenseur`}
                data-elevator={side}
                required
              >
                <option value="">Choisir</option>
                <option value="non">Non</option>
                <option value="oui">Oui</option>
              </select>
            </label>
          </div>
          <label data-elevator-details={side}>
            Dimensions et capacité de l’ascenseur (si présent)
            <input
              name={`${i === 0 ? 'Départ' : 'Arrivée'} — Dimensions ascenseur`}
              placeholder="Largeur, profondeur, hauteur, capacité ou à vérifier"
              maxlength="200"
            />
          </label>
          <label>
            Stationnement, portage et accès
            <textarea
              name={`${i === 0 ? 'Départ' : 'Arrivée'} — Accès`}
              maxlength="1500"
              placeholder="Distance camion–porte, accès camion 20 m³, escalier, autorisation, monte-meubles…"
            />
          </label>
          {i === 1 && (
            <label>
              Stockage intermédiaire ou seconde livraison
              <textarea
                name="Livraison complémentaire"
                maxlength="1000"
                placeholder="Ex. : stockage pendant 2 semaines avant la livraison, ou une partie des meubles à déposer à une seconde adresse. Précisez les lieux, les dates et les biens concernés."
              />
            </label>
          )}
        </fieldset>
      ))}
      <fieldset class="mb-8 border-0 p-0" data-step="volume">
        <legend class="mb-6 text-2xl font-bold" tabindex="-1">
          Vos biens à transporter
        </legend>
        <p class="field-help">
          Renseignez un volume estimé ou un inventaire. Vous pourrez préciser
          ces éléments avec MAZAT Transport.
        </p>
        <div class="form-row">
          <label>
            Volume estimé (m³)
            <input
              name="Volume estimé (m³)"
              id="volume"
              type="number"
              min="1"
              max="10000"
              step="1"
            />
          </label>
          <label>
            Nombre de cartons estimé *
            <input
              name="Nombre de cartons"
              type="number"
              min="0"
              max="100000"
              required
            />
          </label>
        </div>
        <label>
          Inventaire par pièce
          <textarea
            name="Inventaire"
            id="inventory"
            maxlength="5000"
            placeholder="Ex. salon : canapé 3 places, table, 6 chaises ; chambre : lit, armoire…"
          />
        </label>
        <label>
          Objets particuliers ou fragiles
          <textarea
            name="Objets particuliers"
            maxlength="1500"
            placeholder="Piano, coffre, œuvre, meuble lourd : dimensions, poids estimé, démontage…"
          />
        </label>
        <label for="quote-photos">Photos (facultatif, 3 maximum)</label>
        <input
          id="quote-photos"
          type="file"
          name="Photos"
          accept="image/jpeg,image/png,image/webp"
          multiple
          aria-describedby="photos-help photos-selection"
        />
        <div
          id="photos-preview"
          class="mt-3 grid grid-cols-3 gap-3"
          aria-label="Photos sélectionnées"
        ></div>
        <p id="photos-help" class="mt-2 text-sm text-slate-600">
          Ajoutez des photos des objets, meubles, cartons, de l’ascenseur ou des
          accès. JPEG, PNG ou WebP, 25 Mo maximum par fichier. Les photos sont
          réduites et converties en JPEG avant l’envoi. Évitez les documents
          d’identité et les informations sensibles.
        </p>
        <p
          id="photos-selection"
          class="mt-2 text-sm text-slate-600"
          role="status"
        ></p>
        <button
          id="clear-photos"
          type="button"
          class="mt-3 min-h-11 w-full rounded-sm border border-slate-300 px-4 py-2 text-sm sm:w-auto"
          hidden
        >
          Retirer les photos
        </button>
      </fieldset>
      <fieldset class="mb-8 border-0 p-0" data-step="export">
        <legend class="mb-6 text-2xl font-bold" tabindex="-1">
          Votre expédition internationale
        </legend>
        <label>
          Mode d’expédition *
          <select name="Mode export" required>
            <option value="">Choisir</option>
            <option>Groupage maritime (LCL)</option>
            <option>Conteneur dédié (FCL)</option>
            <option>À définir ensemble</option>
          </select>
        </label>
        <label>
          Périmètre souhaité
          <select name="Périmètre export">
            <option>À définir au devis</option>
            <option>Porte-à-porte</option>
            <option>Collecte et expédition</option>
            <option>Autre périmètre</option>
          </select>
        </label>
        <label>
          Poids estimé et inventaire valorisé
          <textarea
            name="Poids et valeur export"
            maxlength="1500"
            placeholder="Poids approximatif, valeur déclarée à étudier, inventaire disponible…"
          />
        </label>
        <label>
          Biens sensibles ou réglementés
          <textarea
            name="Biens sensibles ou réglementés"
            maxlength="1500"
            placeholder="Objets concernés, contraintes connues ou « à confirmer »"
          />
        </label>
        <label>
          Résidence fiscale
          <textarea
            name="Résidence fiscale"
            maxlength="500"
            placeholder="Pays de résidence fiscale ou « à confirmer »"
          />
        </label>
        <label>
          Statut d’importation
          <textarea
            name="Statut d’importation"
            maxlength="1500"
            placeholder="Changement de résidence, statut d’importation ou « à confirmer »"
          />
        </label>
        <label>
          Disponibilité et langue de la liste de colisage *
          <select name="Liste de colisage — disponibilité et langue" required>
            <option value="">À préciser</option>
            <option>Disponible en français</option>
            <option>Disponible en anglais</option>
            <option>Disponible en français et anglais</option>
            <option>À préparer / à fournir</option>
            <option>Disponibilité et langue à confirmer</option>
          </select>
        </label>
        <p class="text-sm text-slate-600">
          Une liste de colisage peut être nécessaire selon la destination et les
          partenaires. Aucun document n’est téléversé ici ; vous pourrez le
          transmettre ultérieurement si demandé.
        </p>
        <label>
          Statut de l’Incoterm ou du périmètre contractuel *
          <select id="incoterm-status" name="Incoterm / périmètre" required>
            <option value="">Choisir</option>
            <option value="a-definir">À définir avec le commissionnaire</option>
            <option value="defini">Déjà défini (à préciser)</option>
          </select>
        </label>
        <div id="incoterm-details" hidden>
          <label>
            Incoterm ou périmètre déjà convenu *
            <input
              id="incoterm-value"
              name="Incoterm ou périmètre convenu"
              maxlength="250"
              placeholder="Terme convenu ou périmètre écrit"
            />
          </label>
        </div>
        <label>
          Contact expéditeur pour l’adresse de départ *
          <select id="sender-contact-status" name="Contact expéditeur" required>
            <option value="">Choisir</option>
            <option value="demandeur">
              Demandeur (coordonnées à l’étape suivante)
            </option>
            <option value="autre">
              Autre expéditeur (coordonnées à préciser)
            </option>
            <option value="a-confirmer">À confirmer</option>
          </select>
        </label>
        <div id="sender-contact-fields" hidden>
          <div class="form-row">
            <label>
              Nom de l’expéditeur *
              <input
                name="Autre expéditeur — nom"
                autocomplete="section-export-sender name"
                maxlength="150"
              />
            </label>
            <label>
              Téléphone de l’expéditeur *
              <input
                name="Autre expéditeur — téléphone"
                type="tel"
                autocomplete="section-export-sender tel"
                maxlength="30"
              />
            </label>
          </div>
          <label>
            Email de l’expéditeur *
            <input
              name="Autre expéditeur — email"
              type="email"
              autocomplete="section-export-sender email"
              maxlength="254"
            />
          </label>
        </div>
        <label>
          Contact destinataire pour l’adresse d’arrivée *
          <select
            id="recipient-contact-status"
            name="Contact destinataire"
            required
          >
            <option value="">Choisir</option>
            <option value="demandeur">
              Demandeur (coordonnées à l’étape suivante)
            </option>
            <option value="autre">
              Autre destinataire (coordonnées à préciser)
            </option>
            <option value="a-confirmer">À confirmer</option>
          </select>
        </label>
        <div id="recipient-contact-fields" hidden>
          <div class="form-row">
            <label>
              Nom du destinataire *
              <input
                name="Autre destinataire — nom"
                autocomplete="section-export-recipient name"
                maxlength="150"
              />
            </label>
            <label>
              Téléphone du destinataire *
              <input
                name="Autre destinataire — téléphone"
                type="tel"
                autocomplete="section-export-recipient tel"
                maxlength="30"
              />
            </label>
          </div>
          <label>
            Email du destinataire *
            <input
              name="Autre destinataire — email"
              type="email"
              autocomplete="section-export-recipient email"
              maxlength="254"
            />
          </label>
        </div>
        <p class="notice">
          Les frais portuaires, manutention, stockage, douanes, assurance et
          livraison seront à confirmer au devis. Aucun calcul de fret, de taxe
          ou de TVA n’est effectué ici.
        </p>
      </fieldset>
      <fieldset class="mb-8 border-0 p-0" data-step="contact">
        <legend class="mb-6 text-2xl font-bold" tabindex="-1">
          Vos coordonnées
        </legend>
        <div class="form-row">
          <label>
            Prénom *
            <input
              name="Prénom"
              autocomplete="given-name"
              required
              maxlength="100"
            />
          </label>
          <label>
            Nom *
            <input
              name="Nom"
              autocomplete="family-name"
              required
              maxlength="100"
            />
          </label>
        </div>
        <label>
          Email *
          <input
            name="Email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
          />
        </label>
        <label>
          Téléphone *
          <span class="phone-field mt-2 flex items-stretch">
            <span
              class="flex shrink-0 items-center gap-2 rounded-l-sm border border-r-0 border-slate-400 bg-slate-100 px-3"
              aria-hidden="true"
            >
              🇫🇷 +33
            </span>
            <input
              id="contact-phone"
              name="Téléphone"
              type="tel"
              inputmode="tel"
              autocomplete="tel-national"
              pattern="0?[1-9][0-9]{8}"
              placeholder="0612345678"
              aria-describedby="contact-phone-help"
              required
              minlength="9"
              maxlength="10"
            />
          </span>
          <span
            id="contact-phone-help"
            class="mt-2 block text-sm font-normal text-slate-600"
          >
            Numéro français (+33) : 10 chiffres avec le 0 initial, ou 9 sans le
            0, sans espaces.
          </span>
        </label>
        <div data-business>
          <label>
            Société
            <input name="Société" autocomplete="organization" maxlength="150" />
          </label>
          <label>
            SIRET (facultatif)
            <input
              name="SIRET"
              inputmode="numeric"
              pattern="[0-9 ]{14,18}"
              maxlength="18"
            />
          </label>
        </div>
        <label>
          Plage de rappel préférée
          <select
            id="callback-slot"
            name="Plage de rappel"
            aria-describedby="callback-help"
          >
            <option value="">Sans préférence</option>
          </select>
        </label>
        <p id="callback-help" class="mb-5 text-sm text-slate-600">
          Aujourd’hui et les six jours suivants, le matin ou l’après-midi (heure
          de Paris). Indiquez une préférence ; le rappel reste soumis à
          disponibilité.
        </p>
        <label>
          Comment nous avez-vous connus ?
          <select name="Provenance">
            <option>Non précisé</option>
            <option>Recherche en ligne</option>
            <option>Recommandation</option>
            <option>Réseaux sociaux</option>
            <option>Autre</option>
          </select>
        </label>
        <label>
          Votre message (facultatif)
          <textarea
            name="Message"
            maxlength="3000"
            placeholder="Les précisions utiles pour votre projet…"
          />
        </label>
        <label>
          Questions complémentaires (facultatif)
          <textarea
            name="Questions complémentaires"
            maxlength="2000"
            placeholder="Vos questions sur les prestations, les accès, l’organisation ou les délais…"
          />
        </label>
        <label class="check-label">
          <input
            type="checkbox"
            name="Information données"
            value="Lue et acceptée"
            required
          />
          <span>
            J’ai lu{' '}
            <a class="text-link" href="/confidentialite/">
              l’information sur mes données
            </a>{' '}
            et souhaite que MAZAT Transport me recontacte au sujet de cette
            demande. *
          </span>
        </label>
      </fieldset>
      <div id="quote-review" hidden>
        <h2 id="quote-heading" class="mb-5 text-3xl font-bold" tabindex="-1">
          Votre demande est prête
        </h2>
        <p class="mb-5 text-slate-600">
          Vous pouvez revenir aux étapes précédentes pour modifier vos réponses,
          ou envoyer votre demande à MAZAT Transport.
        </p>
        <p id="quote-confirmation" class="mb-5 text-sm text-slate-600"></p>
        <button
          type="button"
          id="send-request"
          class="min-h-12 w-full rounded-sm border border-red-700 bg-red-700 px-5 py-3 text-sm font-bold text-white sm:w-auto"
        >
          Envoyer ma demande
        </button>
      </div>
      <div
        class="form-buttons mt-6 flex flex-col justify-between gap-3 sm:flex-row"
        hidden
      >
        <button
          type="button"
          class="min-h-12 flex-1 rounded-sm border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800"
          id="previous"
        >
          Retour
        </button>
        <button
          type="submit"
          class="min-h-12 flex-1 rounded-sm border border-red-700 bg-red-700 px-5 py-3 text-sm font-bold text-white"
          id="next"
        >
          Continuer
        </button>
      </div>
    </form>
    <section
      id="submission-panel"
      hidden
      aria-labelledby="submission-title"
      class="py-12 text-center"
    >
      <div
        id="submission-icon"
        aria-hidden="true"
        class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-sky-100 text-3xl text-sky-800"
      >
        …
      </div>
      <h2
        id="submission-title"
        tabindex="-1"
        class="mb-4 text-2xl font-bold"
      ></h2>
      <p
        id="submission-message"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="text-slate-600"
      ></p>
      <button
        id="return-to-quote"
        type="button"
        hidden
        class="mt-6 min-h-12 w-full rounded-sm bg-red-700 px-5 py-3 text-sm font-bold text-white sm:w-auto"
      >
        Revenir à ma demande
      </button>
    </section>
  </div>
</div>
<script src="../lib/quote-form.ts"></script>

<style>
  #quote-form .phone-field input {
    min-width: 0;
    margin-top: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }
  #quote-form .service-pill {
    position: relative;
    display: inline-flex;
    max-width: 100%;
    margin: 0;
    cursor: pointer;
  }

  #quote-form .service-pill input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }

  .service-pill-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border: 1px solid #94a3b8;
    border-radius: 999px;
    background: #fff;
    color: #334155;
  }

  .service-pill-icon {
    flex-shrink: 0;
    width: 1rem;
    text-align: center;
  }

  .service-pill-check {
    display: none;
  }
  .service-pill:hover .service-pill-content {
    border-color: #b91c1c;
  }
  .service-pill input:checked + .service-pill-content {
    border-color: #b91c1c;
    background: #b91c1c;
    color: #fff;
  }
  .service-pill input:checked + .service-pill-content .service-pill-add {
    display: none;
  }
  .service-pill input:checked + .service-pill-content .service-pill-check {
    display: inline;
  }
  .service-pill input:focus-visible + .service-pill-content {
    outline: 3px solid #0369a1;
    outline-offset: 3px;
  }

  .quote-progress {
    appearance: none;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    background: #e2e8f0;
    color: #b91c1c;
  }
  .quote-progress::-webkit-progress-bar {
    background: #e2e8f0;
  }
  .quote-progress::-webkit-progress-value {
    background: #b91c1c;
  }
  .quote-progress::-moz-progress-bar {
    background: #b91c1c;
