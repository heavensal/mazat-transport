---
import { business } from '../site/config';
const configuredKey = import.meta.env.GOOGLE_MAPS_API_KEY?.trim() || '';
const apiKey = configuredKey.startsWith('YOUR_') ? '' : configuredKey;
const reviewsUrl = `https://www.google.com/maps/search/?api=1&query=MAZAT%20Transport&query_place_id=${business.googlePlaceId}`;
---

<section
  class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24"
  data-google-reviews
  data-api-key={apiKey}
  data-place-id={business.googlePlaceId}
>
  <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
    La confiance se construit sur le terrain
  </p>
  <div class="mb-6 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
    <h2 class="m-0 text-3xl font-bold md:text-5xl">
      Leurs expériences,
      <br />
      vos premiers repères.
    </h2>
    <a
      class="font-bold underline decoration-slate-300 underline-offset-4 hover:text-red-800"
      href={reviewsUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Tous les avis sur Google Maps <span class="sr-only">(nouvel onglet)</span>
    </a>
  </div>
  <p class="mb-6 text-sm text-slate-600">
    Sélection d’avis 5 étoiles parmi les avis proposés par Google, présentés du
    plus récent au plus ancien. Cette sélection ne représente pas l’ensemble des
    avis.
  </p>
  <p data-reviews-status role="status" class="mb-6 text-slate-600"></p>
  <noscript>
    Consultez les avis directement sur Google Maps grâce au lien ci-dessus.
  </noscript>
  <div data-reviews-list class="grid gap-6 md:grid-cols-3"></div>
  <div data-reviews-attributions class="mt-4 text-sm text-slate-600"></div>
  <p class="mt-5 text-sm text-slate-600">
    Les avis sont chargés depuis Google lors de votre visite.{' '}
    <a href="https://policies.google.com/privacy" class="underline">
      Confidentialité Google
    </a>{' '}
    ·{' '}
    <a href="https://maps.google.com/help/terms_maps/" class="underline">
      Conditions Google Maps
    </a>
  </p>
  <template data-review-template>
    <article class="rounded-sm border border-slate-200 bg-white p-6">
      <p data-review-author class="font-bold"></p>
      <p class="my-3 text-amber-700">
        <span aria-hidden="true">★★★★★</span>
        <span class="sr-only">5 étoiles sur 5</span>
      </p>
      <p data-review-date class="mb-3 text-sm text-slate-600"></p>
      <blockquote
        data-review-text
        class="m-0 whitespace-pre-line break-words text-slate-700"
      ></blockquote>
      <p data-review-visit class="mt-3 text-sm text-slate-600"></p>
      <div data-review-links class="mt-4 flex flex-wrap gap-4 text-sm"></div>
      <p
        translate="no"
        class="mt-4 font-sans text-xs font-normal not-italic tracking-normal whitespace-nowrap text-[#5e5e5e]"
      >
        Google Maps
      </p>
    </article>
  </template>
</section>
<script src="../lib/google-reviews.ts"></script>
