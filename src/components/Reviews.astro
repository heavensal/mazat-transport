---
import { business } from '../site/config';
const configuredKey = import.meta.env.GOOGLE_MAPS_API_KEY?.trim() || '';
const apiKey = configuredKey.startsWith('YOUR_') ? '' : configuredKey;
const reviewsUrl = `https://www.google.com/maps/search/?api=1&query=MAZAT%20Transport&query_place_id=${business.googlePlaceId}`;
---

<section
  class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24"
  data-google-reviews
  data-api-key={apiKey}
  data-place-id={business.googlePlaceId}
>
  <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
    <img src="https://www.gstatic.com/images/branding/product/1x/gsa_48dp.png" width="24" height="24" alt="" class="mr-2 inline-block align-middle" />
    Avis Google
  </p>
  <div class="mb-6 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
    <h2 class="m-0 text-3xl font-bold md:text-5xl">
      Leurs expériences,
      <br />
      vos premiers repères.
    </h2>
    <a
      class="font-bold underline decoration-slate-300 underline-offset-4 hover:text-red-800"
      href={reviewsUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Tous les avis sur Google Maps <span class="sr-only">(nouvel onglet)</span>
    </a>
  </div>
  <p class="mb-6 text-sm text-slate-600">
    Sélection d’avis 5 étoiles parmi les avis proposés par Google, présentés du
    plus récent au plus ancien. Cette sélection ne représente pas l’ensemble des
    avis.
  </p>
  <p data-reviews-status role="status" class="mb-6 text-slate-600"></p>
  <noscript>
    Consultez les avis directement sur Google Maps grâce au lien ci-dessus.
  </noscript>
  <div data-reviews-list aria-label="Avis Google" tabindex="0" class="grid snap-x snap-mandatory auto-cols-[85%] grid-flow-col gap-4 overflow-x-auto pb-4 md:auto-cols-auto md:grid-flow-row md:grid-cols-3 md:gap-6 md:overflow-visible"></div>
  <div data-reviews-attributions class="mt-4 text-sm text-slate-600"></div>
  <p class="mt-5 text-sm text-slate-600">
    Les avis sont chargés depuis Google lors de votre visite.{' '}
    <a href="https://policies.google.com/privacy" class="underline">
      Confidentialité Google
    </a>{' '}
    ·{' '}
    <a href="https://maps.google.com/help/terms_maps/" class="underline">
      Conditions Google Maps
    </a>
  </p>
  <aside class="mt-8 flex flex-wrap items-center gap-4 border-t border-slate-200 pt-6">
    <img src="https://www.demenagement24.com/resources/img/icons/svg/move/sites/demenagement24_com/icon-32-logo-white.svg" alt="" class="h-10 w-36 bg-slate-950 object-contain p-2" />
    <a href={business.reviewsUrl} class="font-semibold underline underline-offset-4">Retrouvez aussi MAZAT TRANSPORT sur Déménagement24</a>
  </aside>
  <dialog data-review-dialog aria-labelledby="review-dialog-title" class="review-dialog fixed inset-0 m-auto h-[80dvh] w-[80dvw] max-w-xl overflow-y-auto rounded-lg bg-white p-5 text-slate-900 backdrop:bg-black/60 md:h-auto md:max-h-[80dvh]">
    <div class="mb-4 flex items-center justify-between gap-4">
      <h3 id="review-dialog-title" class="text-xl font-bold">Avis Google complet</h3>
      <form method="dialog">
        <button autofocus aria-label="Fermer l’avis" class="min-h-11 min-w-11 text-3xl">×</button>
      </form>
    </div>
    <div data-review-full></div>
  </dialog>
  <template data-review-template>
    <article class="review-card flex min-w-0 snap-start flex-col rounded-sm border border-slate-200 bg-white p-5">
      <p data-review-author class="font-bold"></p>
      <p class="my-3 text-amber-700">
        <span aria-hidden="true">★★★★★</span>
        <span class="sr-only">5 étoiles sur 5</span>
      </p>
      <p data-review-date class="mb-3 text-sm text-slate-600"></p>
      <blockquote
        data-review-text
        class="review-excerpt m-0 whitespace-pre-line wrap-break-word leading-6 text-slate-700"
      ></blockquote>
      <button type="button" data-review-more class="mt-2 min-h-11 self-start font-semibold underline underline-offset-4">Voir +</button>
      <p data-review-visit class="mt-3 text-sm text-slate-600"></p>
      <div data-review-links class="mt-4 flex flex-wrap gap-4 text-sm"></div>
      <p
        translate="no"
        class="mt-auto pt-4 font-sans text-xs font-normal not-italic tracking-normal whitespace-nowrap text-[#5e5e5e]"
      >
        Google Maps
      </p>
    </article>
  </template>
</section>
<style>
  [data-reviews-list] .review-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
    height: 7.5rem;
  }

  [data-reviews-list] .review-excerpt[data-truncated] {
    mask-image: linear-gradient(#000 78%, transparent);
  }

  @media (min-width: 48rem) {
    [data-reviews-list] .review-card:nth-child(n + 4) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .review-dialog {
      opacity: 0;
      transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
    }

    .review-dialog[open] { opacity: 1; }

    .review-dialog::backdrop {
      opacity: 0;
      transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
    }

    .review-dialog[open]::backdrop { opacity: 1; }

    @starting-style {
      .review-dialog[open], .review-dialog[open]::backdrop { opacity: 0; }
    }
  }
</style>
<script src="../lib/google-reviews.ts"></script>
