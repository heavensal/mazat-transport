---
import '../styles/global.css';
import {
  business,
  navigation,
  siteUrl,
  publicationReady,
} from '../site/config';
import { publication } from '../site/publication';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).href
  : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  name: business.name,
  telephone: business.phone,
  email: business.email,
  ...(siteUrl
    ? {
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: new URL('/images/mazat-logo-512.png', siteUrl).href,
          width: 512,
          height: 512,
          caption: business.name,
        },
      }
    : {}),
  areaServed: [
    'Marseille',
    'Bouches-du-Rhône',
    'Var',
    'Alpes-Maritimes',
    'France',
  ],
  description:
    'Déménagement de particuliers et entreprises, en France et à l’international selon faisabilité.',
};
const socialImage = siteUrl
  ? new URL('/images/mazat-social-1200x630.png', siteUrl).href
  : '/images/mazat-social-1200x630.png';
const socialImageAlt =
  'MAZAT Transport Déménagement — logo au camion rouge sur fond noir';
---

<!doctype html>
<html lang={publication.defaultLocale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121719" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={
        noindex || !publicationReady ? 'noindex, follow' : 'index, follow'
      }
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="application-name" content="MAZAT" />
    <meta name="apple-mobile-web-app-title" content="MAZAT" />
    <link
      rel="icon"
      href="/favicon.ico"
      sizes="16x16 32x32 48x48"
      type="image/x-icon"
    />
    <link
      rel="icon"
      href="/favicons/favicon-16x16.png"
      sizes="16x16"
      type="image/png"
    />
    <link
      rel="icon"
      href="/favicons/favicon-32x32.png"
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="icon"
      href="/favicons/favicon-48x48.png"
      sizes="48x48"
      type="image/png"
    />
    <link
      rel="icon"
      href="/favicons/favicon-96x96.png"
      sizes="96x96"
      type="image/png"
    />
    <link
      rel="apple-touch-icon"
      href="/favicons/apple-touch-icon-152x152.png"
      sizes="152x152"
    />
    <link
      rel="apple-touch-icon"
      href="/favicons/apple-touch-icon-167x167.png"
      sizes="167x167"
    />
    <link
      rel="apple-touch-icon"
      href="/favicons/apple-touch-icon.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
  </head>
  <body class="m-0 bg-white font-sans text-base leading-relaxed text-slate-800 antialiased">
    <a
      class="fixed -top-full left-5 z-50 bg-white px-4 py-3 text-black focus:top-3"
      href="#main"
    >
      Aller au contenu
    </a>
    <div class="border-b border-slate-700 bg-slate-950 text-sm text-slate-300">
      <div class="mx-auto flex w-11/12 max-w-7xl justify-between gap-5 px-0 py-2 md:w-5/6">
        <span class="hidden md:inline">
          Marseille · Côte d’Azur · France · International
        </span>
        <a
          class="mx-auto underline-offset-4 hover:underline md:mx-0"
          href={business.phoneHref}
        >
          Parlons de votre projet : {business.phone}
        </a>
      </div>
    </div>
    <header class="relative z-10 border-b border-slate-200 bg-white">
      <div class="mx-auto flex min-h-24 w-11/12 max-w-7xl flex-wrap items-center justify-between gap-6 py-4 md:w-5/6 lg:flex-nowrap">
        <a
          class="flex shrink-0 items-center gap-3"
          href="/"
          aria-label="MAZAT, accueil"
        >
          <img
            class="h-16 w-16 rounded-full md:h-18 md:w-18"
            src="/images/mazat-logo-128.png"
            srcset="/images/mazat-logo-128.webp 128w, /images/mazat-logo-256.webp 256w"
            sizes="70px"
            width="76"
            height="76"
            alt=""
          />
          <span class="text-xl font-black leading-tight tracking-widest md:text-2xl">
            MAZAT
            <small class="mt-2 block text-xs tracking-wide">
              TRANSPORT & DÉMÉNAGEMENT
            </small>
          </span>
        </a>
        <button
          class="min-h-11 border border-slate-300 bg-white px-4 py-2 lg:hidden"
          aria-expanded="false"
          aria-controls="main-nav"
          hidden
        >
          Menu <span aria-hidden="true">☰</span>
        </button>
        <nav
          id="main-nav"
          class="hidden w-full flex-col items-stretch gap-0 text-center text-sm font-semibold lg:flex lg:w-auto lg:flex-row lg:flex-wrap lg:items-center lg:gap-6"
          aria-label="Navigation principale"
        >
          {navigation.map((item) => (
            <a
              class="block px-3 py-3 underline-offset-4 hover:underline lg:px-0 lg:py-2 aria-[current=page]:text-red-800"
              href={item.href}
              aria-current={
                Astro.url.pathname === item.href ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          ))}
          <a
            class="mt-2 inline-flex min-h-11 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-5 py-3 text-sm font-bold text-white no-underline hover:bg-red-800 lg:mt-0"
            href="/devis/"
          >
            Devis gratuit
          </a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <section class="border-t border-slate-200 bg-slate-100 px-0 py-16">
      <div class="mx-auto flex w-11/12 max-w-7xl flex-col items-start justify-between gap-10 md:w-5/6 md:flex-row md:items-center">
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
            Chaque projet commence par un échange
          </p>
          <h2 class="m-0 text-3xl font-bold leading-tight md:text-4xl">
            Et si on préparait
            <br />
            votre prochain départ ?
          </h2>
        </div>
        <div class="flex flex-col items-start gap-4 md:items-center">
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white no-underline hover:bg-red-800"
            href="/devis/"
          >
            Demander mon devis gratuit
          </a>
          <a
            class="text-sm underline-offset-4 hover:underline"
            href={business.phoneHref}
          >
            Parler à un conseiller · {business.phone}
          </a>
        </div>
      </div>
    </section>
    <footer class="bg-slate-950 px-0 pb-24 pt-14 text-slate-200 md:pb-6">
      <div class="mx-auto grid w-11/12 max-w-7xl grid-cols-2 gap-8 md:w-5/6 md:grid-cols-4 md:gap-10">
        <div>
          <a
            class="flex items-center"
            href="/"
            aria-label="MAZAT, retour à l’accueil"
          >
            <img
              class="h-20 w-20"
              src="/images/mazat-logo-128.png"
              srcset="/images/mazat-logo-128.webp 128w, /images/mazat-logo-256.webp 256w"
              sizes="70px"
              width="90"
              height="90"
              alt=""
            />
          </a>
          <p class="mt-3 text-sm text-slate-400">
            Déménagement & transport.
            <br />
            Le soin à chaque étape.
          </p>
        </div>
        <div>
          <h2 class="mb-6 text-sm font-bold tracking-wide">Votre projet</h2>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/formules/"
          >
            Nos cinq formules
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/export-maritime/"
          >
            Export maritime
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/services/"
          >
            Services à la carte
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/entreprises/"
          >
            Entreprises
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/realisations-avis/"
          >
            Réalisations & avis
          </a>
        </div>
        <div>
          <h2 class="mb-6 text-sm font-bold tracking-wide">
            Nos interventions
          </h2>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/demenagement-marseille/"
          >
            Marseille & Bouches-du-Rhône
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/demenagement-nice/"
          >
            Nice & Alpes-Maritimes
          </a>
          <p class="mt-3 text-sm text-slate-400">
            Var · PACA
            <br />
            France & international
            <br />
            Selon faisabilité
          </p>
        </div>
        <div class="col-span-2 md:col-span-1">
          <h2 class="mb-6 text-sm font-bold tracking-wide">À votre écoute</h2>
          <a
            class="block text-xl font-bold underline-offset-4 hover:underline"
            href={business.phoneHref}
          >
            {business.phone}
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href={`mailto:${business.email}`}
          >
            {business.email}
          </a>
          <a
            class="block break-words py-1 text-sm underline-offset-4 hover:underline"
            href="/devis/"
          >
            Préparer ma demande
          </a>
        </div>
      </div>
      <div class="mx-auto mt-12 flex w-11/12 max-w-7xl flex-col justify-between gap-6 border-t border-slate-700 pt-6 text-xs text-slate-400 md:w-5/6 md:flex-row">
        <span>© {new Date().getFullYear()} MAZAT Transport</span>
        <div class="flex flex-wrap gap-4">
          <a
            class="underline-offset-4 hover:underline"
            href="/mentions-legales/"
          >
            Mentions légales
          </a>
          <a
            class="underline-offset-4 hover:underline"
            href="/confidentialite/"
          >
            Confidentialité
          </a>
          <a class="underline-offset-4 hover:underline" href="/cookies/">
            Cookies
          </a>
          <a class="underline-offset-4 hover:underline" href="/conditions/">
            CGV & médiation
          </a>
        </div>
      </div>
    </footer>
    <div class="fixed inset-x-0 bottom-0 z-20 grid grid-cols-2 bg-slate-950 pb-6 shadow-lg md:hidden">
      <a
        class="px-3 py-4 text-center text-sm font-bold text-white"
        href={business.phoneHref}
      >
        Appeler MAZAT
      </a>
      <a
        class="bg-red-700 px-3 py-4 text-center text-sm font-bold text-white"
        href="/devis/"
      >
        Devis gratuit
      </a>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(
        'button[aria-controls="main-nav"]',
      );
      const nav = document.querySelector<HTMLElement>('#main-nav');
      if (toggle && nav) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('hidden', !open);
          nav.classList.toggle('flex', open);
        });
        document.addEventListener('keydown', (event) => {
          if (
            event.key === 'Escape' &&
            toggle.getAttribute('aria-expanded') === 'true'
          ) {
            toggle.setAttribute('aria-expanded', 'false');
            nav.classList.add('hidden');
            nav.classList.remove('flex');
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
