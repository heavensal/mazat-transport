---
import Layout from '../layouts/Layout.astro';
import Offers from '../components/Offers.astro';
import Reviews from '../components/Reviews.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { pages } from '../site/pages';
import { business } from '../site/config';
export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}
const { page } = Astro.props;
const exportOptions = [
  [
    'Groupage maritime · LCL',
    'Pour quelques cartons et les petits ou moyens volumes. Votre expédition rejoint un groupage ; le calendrier dépend des consolidations. Emballage et inventaire détaillés sont préparés pour le trajet.',
  ],
  [
    'Conteneur dédié · FCL',
    'Pour les volumes importants et logements complets. Conteneur de 20 ou 40 pieds selon cubage, itinéraire, faisabilité et conditions de chargement.',
  ],
  [
    'Accompagnement porte-à-porte',
    'Collecte, emballage export, opérations portuaires, transport et livraison finale selon le périmètre du contrat, avec les partenaires nécessaires à destination.',
  ],
];
---

<Layout
  title={page.title}
  description={page.description}
  noindex={['legal', 'privacy', 'terms'].includes(page.id)}
>
  <section class="bg-slate-950 py-16 text-white md:py-20">
    <div class="mx-auto w-11/12 max-w-7xl md:w-5/6">
      <div class="mb-8 text-sm text-slate-300">
        <a class="underline" href="/">
          Accueil
        </a>{' '}
        / {page.eyebrow}
      </div>
      <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-200">
        {page.eyebrow}
      </p>
      <h1 class="mb-6 max-w-4xl text-4xl font-extrabold leading-tight md:text-6xl">
        {page.heading.split('\n').map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      <p class="max-w-3xl text-lg text-slate-300">{page.intro}</p>
    </div>
  </section>
  {page.id === 'offers' && (
    <section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
      <Offers full />
      <div
        class="mt-10 max-w-full overflow-x-auto"
        tabindex="0"
        role="region"
        aria-label="Comparatif des formules, défilement horizontal"
      >
        <table class="w-full border-collapse text-sm">
          <caption class="mb-4 text-left font-bold">
            Les principaux niveaux de prise en charge
          </caption>
          <thead class="bg-slate-100">
            <tr>
              <th class="border border-slate-200 p-4 text-left" scope="col">
                Prestation
              </th>
              {['Économique', 'Éco+', 'Standard', 'Premium', 'Luxe / VIP'].map(
                (t) => (
                  <th class="border border-slate-200 p-4 text-left" scope="col">
                    {t}
                  </th>
                ),
              )}
            </tr>
          </thead>
          <tbody>
            {[
              [
                'Chargement, transport, déchargement',
                'Inclus',
                'Inclus',
                'Inclus',
                'Inclus',
                'Inclus',
              ],
              [
                'Protection du mobilier',
                'Usuelle',
                'Renforcée',
                'Selon devis',
                'Adaptée',
                'Adaptée',
              ],
              [
                'Cartons et adhésif',
                'En option',
                'Selon devis',
                'Fragiles selon devis',
                'Adaptés',
                'Adaptés',
              ],
              [
                'Démontage / remontage',
                'Selon devis',
                'Si prévu au devis',
                'Meubles démontables',
                'Inclus selon périmètre',
                'Inclus selon périmètre',
              ],
              [
                'Emballage des fragiles',
                'Par le client',
                'Par le client',
                'Inclus',
                'Inclus',
                'Inclus',
              ],
              [
                'Emballage du contenu',
                'Par le client',
                'Par le client',
                'Hors fragiles : client',
                'Inclus',
                'Inclus',
              ],
              [
                'Remise en place des placards',
                'Non incluse',
                'Non incluse',
                'Non incluse',
                'Selon devis',
                'Incluse',
              ],
              [
                'Nettoyage',
                'Sur demande',
                'Sur demande',
                'Sur demande',
                'Sur demande',
                'Selon zone et devis',
              ],
            ].map((row) => (
              <tr>
                <th
                  class="min-w-32 border border-slate-200 p-4 text-left"
                  scope="row"
                >
                  {row[0]}
                </th>
                {row.slice(1).map((cell) => (
                  <td class="min-w-32 border border-slate-200 p-4 text-left">
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-10 border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-sm text-slate-700">
        Le devis signé précise les inclusions, les quantités et les options. Les
        cartons, penderies, remontages et prestations de nettoyage ne sont pas
        identiques sur toutes les opérations.
      </p>
    </section>
  )}
  {page.id === 'export' && (
    <>
      <section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
        <div class="mb-10 flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <h2 class="text-3xl font-bold md:text-5xl">
            Trois solutions.
            <br />
            Un projet sur mesure.
          </h2>
          <p class="max-w-md text-slate-600">
            De l’étude du volume à la remise à destination, retenez un périmètre
            adapté à vos besoins.
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {exportOptions.map(([title, text]) => (
            <article class="rounded-sm border border-slate-200 p-8">
              <h3 class="mb-3 text-xl font-bold">{title}</h3>
              <p class="text-slate-600">{text}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="bg-slate-100 py-16 md:py-24">
        <div class="mx-auto w-11/12 max-w-7xl md:w-5/6">
          <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
            Préparer, protéger, acheminer
          </p>
          <h2 class="mb-8 text-3xl font-bold md:text-5xl">
            Les étapes de votre dossier export.
          </h2>
          <ol class="grid gap-8 md:grid-cols-3">
            {[
              [
                'Évaluer votre projet',
                'Pays, villes, volume, date et nature des biens.',
              ],
              [
                'Préparer l’inventaire',
                'Visite ou vidéo, inventaire numéroté et valeur des effets.',
              ],
              [
                'Protéger pour le voyage',
                'Emballage export, fragiles et caisses sur mesure si nécessaires.',
              ],
              [
                'Organiser la consolidation',
                'Acheminement vers la zone de groupage ou le port.',
              ],
              [
                'Coordonner le transport',
                'Fret maritime et formalités selon les partenaires retenus.',
              ],
              [
                'Prévoir l’arrivée',
                'Réception, éventuel dédouanement et livraison selon l’offre.',
              ],
            ].map(([title, text], i) => (
              <li class="border-t-2 border-slate-300 pt-5">
                <span class="mb-4 block text-sm text-sky-700">0{i + 1}</span>
                <h3 class="mb-2 text-lg font-bold">{title}</h3>
                <p class="text-sm text-slate-600">{text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <section class="mx-auto grid w-11/12 max-w-7xl gap-10 py-16 md:w-5/6 md:grid-cols-2 md:py-24">
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
            Pour une étude utile
          </p>
          <h2 class="mb-5 text-3xl font-bold">
            Les informations qui font la différence.
          </h2>
          <p class="mb-6 text-slate-600">
            Pays et villes de départ et d’arrivée, date souhaitée, volume et
            poids estimés, liste des biens et objets particuliers : ces éléments
            permettent d’étudier votre expédition.
          </p>
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white"
            href="/devis/?type=export"
          >
            Obtenir un devis export personnalisé
          </a>
        </div>
        <div class="border-l-3 border-sky-700 bg-sky-50 px-6 py-5">
          <h3 class="mb-3 text-lg font-bold">Un périmètre défini par écrit</h3>
          <p class="mb-3 text-slate-700">
            Emballage, frais de port, manutention, stockage, formalités
            douanières, assurance et livraison : les inclusions et exclusions
            sont précisées au devis.
          </p>
          <p class="text-slate-700">
            Le calendrier, le régime d’importation et les taxes dépendent du
            trajet et du dossier. Aucun délai de transport ni dédouanement
            inclus n’est annoncé sans étude préalable.
          </p>
        </div>
      </section>
    </>
  )}
  {page.id === 'services' && (
    <section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
      <div class="grid gap-6 md:grid-cols-3">
        {[
          [
            'stockage',
            'Garde-meubles & stockage',
            'Besoin de temps entre deux adresses ? La durée, le volume, la nature du stockage et l’assurance sont étudiés séparément.',
          ],
          [
            'acces',
            'Monte-meubles',
            'Une solution à envisager selon les accès et les autorisations. Une visite technique peut être nécessaire avant de retenir ce matériel.',
          ],
          [
            'entreprises',
            'Transfert d’entreprise',
            'Bureaux, informatique et archives : organisation de la protection, de l’étiquetage et des manutentions.',
          ],
          [
            'objets-lourds',
            'Piano & objets lourds',
            'Poids, dimensions, étages et cheminement font l’objet d’une étude technique pour définir le matériel et la manutention adaptés.',
          ],
          [
            'emballage',
            'Emballage & cartons',
            'Housses, couvertures, cartons, papier bulle et penderies selon les biens et la formule. Protection spécifique pour les projets export.',
          ],
          [
            'nettoyage',
            'Nettoyage sur demande',
            'Une prestation optionnelle, selon disponibilité dans la zone et pour le chantier concerné. Le périmètre doit être confirmé au devis.',
          ],
        ].map(([id, title, text]) => (
          <article class="rounded-sm border border-slate-200 p-8" id={id}>
            <h2 class="mb-3 text-2xl font-bold">{title}</h2>
            <p class="mb-5 text-slate-600">{text}</p>
            <a
              class="font-bold underline decoration-slate-300 underline-offset-4"
              href={`/devis/?service=${id}`}
            >
              Décrire mon besoin
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
  {page.id === 'reviews' && (
    <>
      <section class="mx-auto grid w-11/12 max-w-7xl gap-10 py-16 md:w-5/6 md:grid-cols-2 md:py-24">
        <div>
          <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
            Notre façon de travailler
          </p>
          <h2 class="mb-5 text-3xl font-bold md:text-5xl">
            Des biens protégés.
            <br />
            Des étapes préparées.
          </h2>
          <p class="mb-4 text-slate-600">
            MAZAT accompagne particuliers et professionnels dans leurs
            changements de vie et leurs transferts d’activité. Notre approche
            associe organisation, manutention maîtrisée et protection du
            mobilier.
          </p>
          <p class="text-slate-600">
            Housses de literie, couvertures professionnelles, emballage
            renforcé, démontage et remontage : nous adaptons les moyens au devis
            retenu.
          </p>
        </div>
        <div class="border-l-3 border-sky-700 bg-slate-100 p-8">
          <h2 class="mb-4 text-3xl font-bold">Parlons de vos biens.</h2>
          <p class="mb-6 text-slate-600">
            Un meuble fragile, une bibliothèque à démonter ou des effets à
            préparer pour l’export ? Décrivez les particularités de votre
            déménagement pour définir une prise en charge adaptée.
          </p>
          <a
            class="inline-flex min-h-12 items-center justify-center rounded-sm border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800"
            href="/devis/"
          >
            Préparer mon projet
          </a>
        </div>
      </section>
      <Reviews />
    </>
  )}
  {page.id === 'business' && (
    <section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="mb-5 text-3xl font-bold">
            Préparer le transfert, pièce par pièce.
          </h2>
          <p class="mb-4 text-slate-600">
            Le mobilier de bureau, les postes informatiques et les archives ne
            se préparent pas de la même façon. Nous identifions ensemble les
            biens à transporter, les accès des deux sites et les prestations
            nécessaires.
          </p>
          <p class="mb-6 text-slate-600">
            L’étiquetage et la définition des emplacements à l’arrivée
            facilitent la mise en place. Le calendrier et les moyens sont
            précisés au devis, en fonction de votre organisation.
          </p>
          <a
            class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white"
            href="/devis/?type=entreprise"
          >
            Préparer mon transfert d’entreprise
          </a>
        </div>
        <div class="rounded-sm border border-slate-200 p-8">
          <h3 class="mb-4 text-xl font-bold">Pour préparer votre demande</h3>
          <ul class="list-disc pl-5 text-slate-600">
            <li>Sites de départ et d’arrivée, étages et ascenseurs.</li>
            <li>Inventaire des bureaux, sièges, équipements et archives.</li>
            <li>Contraintes de planning et d’accès.</li>
            <li>Besoins d’emballage, démontage, stockage ou manutention.</li>
            <li>Coordonnées du référent et informations de l’entreprise.</li>
          </ul>
        </div>
      </div>
    </section>
  )}
  {(page.id === 'marseille' || page.id === 'nice') && (
    <section class="mx-auto grid w-11/12 max-w-7xl gap-10 py-16 md:w-5/6 md:grid-cols-2 md:py-24">
      <div>
        <h2 class="mb-5 text-3xl font-bold">
          {page.id === 'marseille'
            ? 'De Marseille à votre nouvelle adresse.'
            : 'De la Côte d’Azur à votre destination.'}
        </h2>
        <p class="mb-4 text-slate-600">
          {page.id === 'marseille'
            ? 'Marseille, Aix-en-Provence, Aubagne, La Ciotat et Martigues font partie des zones prioritaires de nos interventions. Que votre trajet reste dans les Bouches-du-Rhône ou se poursuive dans une autre région, votre devis tient compte des deux adresses.'
            : 'Nos projets concernent Nice, Cannes, Antibes et les Alpes-Maritimes, ainsi que Monaco selon faisabilité. Un trajet local, un départ national ou une expédition internationale demande une organisation adaptée à votre destination.'}
        </p>
        <p class="mb-6 text-slate-600">
          {page.id === 'marseille'
            ? 'Précisez le stationnement possible devant le logement, la distance de portage entre le camion et la porte, les étages et les dimensions de l’ascenseur. Si un monte-meubles est envisagé, l’accès et les autorisations doivent être vérifiés.'
            : 'Pour un immeuble ou une résidence, précisez les conditions d’accès au bâtiment, les dimensions de l’ascenseur et les possibilités de stationnement. En cas de stockage intermédiaire ou de seconde livraison, signalez-le dès la demande.'}
        </p>
        <a
          class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white"
          href="/devis/"
        >
          Demander mon devis gratuit
        </a>
      </div>
      <div class="rounded-sm border border-slate-200 p-8">
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
          Un accompagnement adapté
        </p>
        <h3 class="mb-3 text-xl font-bold">
          Local, national ou international.
        </h3>
        <p class="mb-3 text-slate-600">
          Choisissez entre cinq formules de déménagement et des services
          spécifiques, selon les biens à transporter et la préparation que vous
          souhaitez nous confier.
        </p>
        <p class="mb-5 text-slate-600">
          Aucune adresse d’agence locale n’est annoncée ici. Pour échanger sur
          votre projet, contactez directement notre équipe.
        </p>
        <a
          class="font-bold underline decoration-slate-300 underline-offset-4"
          href={business.phoneHref}
        >
          {business.phone}
        </a>
      </div>
    </section>
  )}
  {page.id === 'quote' && (
    <section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
      <QuoteForm />
    </section>
  )}
  {page.id === 'legal' && (
    <section class="mx-auto max-w-3xl px-0 py-16 md:py-24">
      <p class="mb-8 border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-slate-700">
        Version de préparation — publication bloquée tant que l’identité légale,
        le directeur de publication et l’hébergeur ne sont pas confirmés.
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-bold">Contact commercial</h2>
      <p>
        {business.name}
        <br />
        <a href={business.phoneHref}>{business.phone}</a>
        <br />
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-bold">Informations à finaliser</h2>
      <p>
        Les coordonnées administratives du cahier des charges doivent être
        rapprochées du Kbis ou RNE actuel avant publication. L’identité de
        l’hébergeur, le directeur de publication et les identifications
        réglementaires doivent également être validés.
      </p>
    </section>
  )}
  {page.id === 'privacy' && (
    <section class="mx-auto max-w-3xl px-0 py-16 md:py-24">
      <h2 class="mt-10 mb-4 text-2xl font-bold">
        Le formulaire dans cette version
      </h2>
      <p>
        Les informations saisies restent dans la mémoire de votre navigateur
        pendant la préparation. Le site ne les enregistre pas dans une base de
        données ni dans le stockage local. Une actualisation ou la fermeture de
        la page efface la saisie.
      </p>
      <p>
        À la dernière étape, vous pouvez télécharger un récapitulatif ou ouvrir
        un brouillon dans votre logiciel de messagerie. Le site ne peut pas
        vérifier l’envoi ou la réception de cet email. Les données sont
        transmises à MAZAT uniquement si vous envoyez ce message.
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-bold">
        Une question sur votre demande ?
      </h2>
      <p>
        Vous pouvez joindre MAZAT à{' '}
        <a href={`mailto:${business.email}`}>{business.email}</a>.
      </p>
      <p class="mt-8 border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-slate-700">
        Avant la mise en ligne du service de réception, la politique complète
        doit préciser le responsable du traitement, les finalités et bases
        légales, destinataires, prestataires, durées de conservation et
        modalités d’exercice des droits. Cette page décrit uniquement le
        comportement de la version de préparation.
      </p>
    </section>
  )}
  {page.id === 'cookies' && (
    <section class="mx-auto max-w-3xl px-0 py-16 md:py-24">
      <h2 class="mt-10 mb-4 text-2xl font-bold">
        Ce que cette version utilise
      </h2>
      <p>
        Aucun outil d’analyse d’audience, de publicité, carte intégrée ou vidéo
        tierce n’est chargé. Les pages fonctionnent sans cookie non essentiel.
        Aucun bandeau de consentement n’est donc ajouté à cette version.
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-bold">Liens vers d’autres sites</h2>
      <p>
        Le lien vers les avis ouvre Déménagement24. Les règles de
        confidentialité de ce service s’appliquent après votre navigation vers
        ce site.
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-bold">Évolutions à venir</h2>
      <p>
        L’ajout d’un service externe ou d’un outil de mesure nécessite de revoir
        cette information et les choix proposés avant son activation.
      </p>
    </section>
  )}
  {page.id === 'terms' && (
    <section class="mx-auto max-w-3xl px-0 py-16 md:py-24">
      <h2 class="mt-10 mb-4 text-2xl font-bold">Demande, étude et devis</h2>
      <p>
        Les informations envoyées servent à étudier votre projet. La prestation,
        le volume, les accès, les fournitures et les options sont définis dans
        le devis validé par MAZAT.
      </p>
      <h2 class="mt-10 mb-4 text-2xl font-bold">Conditions contractuelles</h2>
      <p>
        Les conditions de réservation, paiement, annulation, assurance et
        réclamation doivent être communiquées dans les documents contractuels
        applicables. Aucune garantie, franchise, échéance de paiement ni TVA
        n’est déduite automatiquement de votre saisie.
      </p>
      <p class="mt-8 border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-slate-700">
        CGV et médiation : documents contractuels validés et coordonnées du
        médiateur conventionné à fournir avant publication. Cette page ne
        remplace pas ces documents.
      </p>
    </section>
  )}
</Layout>
