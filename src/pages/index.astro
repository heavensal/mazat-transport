---
import Layout from '../layouts/Layout.astro';
import Offers from '../components/Offers.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
---
<Layout title="Déménageur Marseille, PACA & International | MAZAT" description="MAZAT accompagne votre déménagement à Marseille, en PACA, en France et à l’international. Cinq formules, protection soignée et devis personnalisé.">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow light">Déménagement · Transport · Export maritime</p><h1>Votre déménagement,<br/><em>notre savoir-faire.</em></h1><p class="hero-description">D’une rue à l’autre, d’un pays à l’autre.<br/>Nous accompagnons votre prochain départ avec méthode, protection et soin.</p><div class="actions"><a class="button" href="/devis/">Demander mon devis gratuit</a><a class="button ghost" href="/formules/">Découvrir nos formules</a></div><p class="hero-note">Particuliers & professionnels · Devis sur mesure</p></div><div class="brand-scene"><div class="scene-top"><span>LE SOIN À CHAQUE ÉTAPE</span><span aria-hidden="true">FR / INT.</span></div><img src="/images/mazat-logo.png" alt="MAZAT Déménagement Transports, logo au camion rouge" width="500" height="500" fetchpriority="high"/><div class="scene-bottom"><span>Votre nouvelle adresse.<br/><strong>La même exigence.</strong></span><span class="route-symbol" aria-hidden="true">● ━━━ ●</span></div></div></div><div class="hero-locations wrap"><span>AU DÉPART OU À DESTINATION DE</span><p>Marseille <i> / </i> Côte d’Azur <i> / </i> France <i> / </i> International</p></div></section>
<section class="proof-strip"><div class="wrap proof-grid">{[['Protection maîtrisée','Des emballages adaptés à vos biens.'],['Devis personnalisé','Un périmètre clair, étudié ensemble.'],['Savoir-faire terrain','Des accès aux manutentions spécifiques.'],['France & international','Des solutions selon votre destination.']].map(([title,text])=><div><h2>{title}</h2><p>{text}</p></div>)}</div></section>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">À chacun sa façon de déménager</p><h2>Le bon niveau de service.<br/>Pour votre nouveau départ.</h2></div><p>Vous préférez préparer vos cartons ou nous confier l’ensemble ? Choisissez votre accompagnement, nous précisons chaque prestation au devis.</p></div><Offers/><a class="text-link section-link" href="/formules/">Comparer les prestations de nos formules</a></section>
<section class="services-band"><div class="section wrap"><div class="section-heading"><div><p class="eyebrow">Bien plus qu’un transport</p><h2>Les bons moyens,<br/>pour chaque situation.</h2></div><a class="text-link" href="/services/">Tous nos services</a></div><div class="service-list">{[['Entreprises & bureaux','Protéger, identifier et organiser votre transfert.','/entreprises/'],['Garde-meubles','Étudier le volume et la durée de votre stockage.','/services/#stockage'],['Monte-meubles & objets lourds','Adapter les moyens aux accès et aux biens.','/services/#acces'],['Emballage & protection','Des fournitures adaptées, jusqu’à l’export.','/services/#emballage']].map(([title,text,url])=><a href={url}><span><h3>{title}</h3><p>{text}</p></span><span class="service-mark" aria-hidden="true">+</span></a>)}</div></div></section>
<section class="export-feature"><div class="wrap export-grid"><div class="maritime-graphic" aria-hidden="true"><span class="graphic-label">MAZAT EXPORT MARITIME</span><div class="container-stack"><div>MAZAT</div><div>FRANCE / INTERNATIONAL</div><div>GROUPAGE / CONTENEUR DÉDIÉ</div></div><span class="graphic-caption">UN NOUVEL HORIZON. LE MÊME SOIN.</span></div><div><p class="eyebrow light">Votre projet au-delà des frontières</p><h2>Vos effets personnels<br/>voyagent loin.<br/><em>Notre exigence reste la même.</em></h2><p>Groupage maritime, conteneur dédié ou accompagnement porte-à-porte : nous étudions votre expédition selon le volume, la destination et le périmètre retenu.</p><a class="button" href="/export-maritime/">Étudier mon export maritime</a><p class="fine-print">Tarif personnalisé. Itinéraires et prestations selon faisabilité.</p></div></div></section>
<Reviews/>
<section class="steps-section section"><div class="wrap"><p class="eyebrow">Un projet clair, du début à la fin</p><h2>On avance ensemble.</h2><ol class="steps">{[['Parlons de votre projet','Vos dates, vos adresses, vos biens et vos attentes.'],['Précisons les détails','Volume, accès et prestations, avec visite ou vidéo si nécessaire.'],['Validons votre devis','Un document détaillé, étudié et validé par MAZAT.'],['Préparons votre départ','L’organisation et la protection prévues pour votre déménagement.']].map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<Faq/>
</Layout>
