---
import Layout from '../layouts/Layout.astro';
import Offers from '../components/Offers.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
---
<Layout title="Déménageur Marseille, PACA & International | MAZAT" description="MAZAT accompagne votre déménagement à Marseille, en PACA, en France et à l’international. Cinq formules, protection soignée et devis personnalisé.">
<section class="overflow-hidden bg-slate-950 text-white"><div class="mx-auto grid w-11/12 max-w-7xl items-center gap-10 py-10 md:w-5/6 lg:grid-cols-5 lg:gap-12 lg:py-16"><div class="lg:col-span-3"><p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-200">Déménagement · Transport · Export maritime</p><h1 class="mb-7 text-5xl font-extrabold leading-none tracking-tight md:text-6xl lg:text-7xl">Votre déménagement,<br/><em class="not-italic text-sky-300">notre savoir-faire.</em></h1><p class="mb-7 max-w-xl text-lg leading-relaxed text-slate-300">D’une rue à l’autre, d’un pays à l’autre.<br/>Nous accompagnons votre prochain départ avec méthode, protection et soin.</p><div class="flex flex-col gap-3 sm:flex-row"><a class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white no-underline hover:bg-red-800" href="/devis/">Demander mon devis gratuit</a><a class="inline-flex min-h-13 items-center justify-center rounded-sm border border-slate-500 bg-transparent px-6 py-4 text-sm font-bold text-white no-underline hover:bg-slate-800" href="/formules/">Découvrir nos formules</a></div><p class="mt-5 text-xs text-slate-400">Particuliers & professionnels · Devis sur mesure</p></div><div class="mx-auto w-full max-w-md border border-slate-700 bg-black p-5 shadow-lg lg:col-span-2"><div class="flex items-center justify-between gap-3 border-b border-slate-700 pb-4 text-xs tracking-widest text-slate-300"><span>LE SOIN À CHAQUE ÉTAPE</span><span aria-hidden="true">FR / INT.</span></div><img class="mx-auto my-4 block h-auto w-full max-w-sm" src="/images/mazat-logo.png" alt="MAZAT Déménagement Transports, logo au camion rouge" width="500" height="500" fetchpriority="high"/><div class="flex items-center justify-between gap-3 border-t border-slate-700 pt-4 text-sm text-slate-300"><span>Votre nouvelle adresse.<br/><strong class="font-medium text-white">La même exigence.</strong></span><span class="text-xl text-red-400" aria-hidden="true">● ━━━ ●</span></div></div></div><div class="mx-auto flex w-11/12 max-w-7xl flex-col gap-3 border-t border-slate-700 py-6 md:w-5/6 md:flex-row md:items-center md:gap-10"><span class="text-xs tracking-widest text-slate-400">AU DÉPART OU À DESTINATION DE</span><p class="m-0 text-white">Marseille <i class="not-italic text-slate-500"> / </i> Côte d’Azur <i class="not-italic text-slate-500"> / </i> France <i class="not-italic text-slate-500"> / </i> International</p></div></section>
<section class="border-b border-slate-200 bg-slate-100"><div class="mx-auto grid w-11/12 max-w-7xl grid-cols-2 gap-6 py-8 md:w-5/6 md:grid-cols-4 md:py-8">{[['Protection maîtrisée','Des emballages adaptés à vos biens.'],['Devis personnalisé','Un périmètre clair, étudié ensemble.'],['Savoir-faire terrain','Des accès aux manutentions spécifiques.'],['France & international','Des solutions selon votre destination.']].map(([title,text])=><div class="border-l-0 border-slate-300 px-0 md:border-l md:px-6 md:first:border-l-0 md:first:pl-0"><h2 class="mb-2 text-base font-bold">{title}</h2><p class="m-0 text-sm text-slate-600">{text}</p></div>)}</div></section>
<section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24"><div class="mb-10 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end"><div><p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">À chacun sa façon de déménager</p><h2 class="m-0 text-3xl font-bold leading-tight md:text-5xl">Le bon niveau de service.<br/>Pour votre nouveau départ.</h2></div><p class="m-0 max-w-md text-slate-600">Vous préférez préparer vos cartons ou nous confier l’ensemble ? Choisissez votre accompagnement, nous précisons chaque prestation au devis.</p></div><Offers/><a class="mt-6 inline-block text-sm font-bold underline decoration-slate-400 underline-offset-4 hover:text-red-800" href="/formules/">Comparer les prestations de nos formules</a></section>
<section class="bg-slate-100"><div class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24"><div class="mb-10 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end"><div><p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">Bien plus qu’un transport</p><h2 class="m-0 text-3xl font-bold leading-tight md:text-5xl">Les bons moyens,<br/>pour chaque situation.</h2></div><a class="font-bold underline decoration-slate-400 underline-offset-4 hover:text-red-800" href="/services/">Tous nos services</a></div><div class="grid grid-cols-1 gap-x-16 md:grid-cols-2">{[['Entreprises & bureaux','Protéger, identifier et organiser votre transfert.','/entreprises/'],['Garde-meubles','Étudier le volume et la durée de votre stockage.','/services/#stockage'],['Monte-meubles & objets lourds','Adapter les moyens aux accès et aux biens.','/services/#acces'],['Emballage & protection','Des fournitures adaptées, jusqu’à l’export.','/services/#emballage']].map(([title,text,url])=><a class="flex items-center justify-between gap-5 border-t border-slate-300 py-7 no-underline hover:[&_h3]:text-sky-700" href={url}><span><h3 class="mb-2 text-xl font-bold">{title}</h3><p class="m-0 text-slate-600">{text}</p></span><span class="text-3xl font-light text-sky-700" aria-hidden="true">+</span></a>)}</div></div></section>
<section class="bg-slate-800 py-16 text-white md:py-20"><div class="mx-auto grid w-11/12 max-w-7xl items-center gap-10 md:w-5/6 md:grid-cols-2 md:gap-16"><div class="flex aspect-square max-w-lg flex-col justify-between border border-slate-500 bg-slate-700 p-6" aria-hidden="true"><span class="text-xs tracking-widest">MAZAT EXPORT MARITIME</span><div class="-skew-y-2 py-8"><div class="ml-auto w-4/5 rounded-sm border-2 border-slate-900 bg-red-700 py-8 px-4 text-2xl font-bold tracking-widest">MAZAT</div><div class="w-5/6 border-2 border-slate-900 bg-sky-700 px-4 py-5 text-xs font-bold tracking-widest">FRANCE / INTERNATIONAL</div><div class="w-full border-2 border-slate-900 bg-slate-500 px-4 py-5 text-xs font-bold tracking-widest text-slate-950">GROUPAGE / CONTENEUR DÉDIÉ</div></div><span class="text-xs tracking-widest text-sky-200">UN NOUVEL HORIZON. LE MÊME SOIN.</span></div><div><p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-200">Votre projet au-delà des frontières</p><h2 class="mb-6 text-3xl font-bold leading-tight md:text-5xl">Vos effets personnels<br/>voyagent loin.<br/><em class="not-italic text-sky-300">Notre exigence reste la même.</em></h2><p class="mb-6 text-slate-300">Groupage maritime, conteneur dédié ou accompagnement porte-à-porte : nous étudions votre expédition selon le volume, la destination et le périmètre retenu.</p><a class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white no-underline hover:bg-red-800" href="/export-maritime/">Étudier mon export maritime</a><p class="mt-5 text-xs text-slate-300">Tarif personnalisé. Itinéraires et prestations selon faisabilité.</p></div></div></section>
<Reviews/>
<section class="bg-slate-100 py-16 md:py-24"><div class="mx-auto w-11/12 max-w-7xl md:w-5/6"><p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">Un projet clair, du début à la fin</p><h2 class="mb-8 text-3xl font-bold md:text-5xl">On avance ensemble.</h2><ol class="grid grid-cols-2 gap-8 pt-6 md:grid-cols-4">{[['Parlons de votre projet','Vos dates, vos adresses, vos biens et vos attentes.'],['Précisons les détails','Volume, accès et prestations, avec visite ou vidéo si nécessaire.'],['Validons votre devis','Un document détaillé, étudié et validé par MAZAT.'],['Préparons votre départ','L’organisation et la protection prévues pour votre déménagement.']].map(([title,text],i)=><li class="border-t-2 border-slate-300 pt-5"><span class="mb-5 block text-sm text-sky-700">0{i+1}</span><h3 class="mb-2 text-lg font-bold">{title}</h3><p class="m-0 text-sm text-slate-600">{text}</p></li>)}</ol></div></section>
<Faq/>
</Layout>
