---
import seaport from '../../../assets/images/seaport.jpg';
---

<section
  class="bg-slate-950 bg-cover bg-center py-16 text-white md:py-20"
  style={`background-image: linear-gradient(rgb(2 6 23 / 0.82), rgb(2 6 23 / 0.82)), url('${seaport.src}')`}
>
  <div class="mx-auto grid w-11/12 max-w-7xl items-center gap-10 md:w-5/6 md:grid-cols-2 md:gap-16">
    <div
      class="flex aspect-square max-w-lg flex-col justify-between border border-slate-500 bg-slate-700 p-6"
      aria-hidden="true"
    >
      <span class="text-xs tracking-widest">MAZAT TRANSPORT EXPORT MARITIME</span>
      <div class="-skew-y-2 py-8">
        <div class="ml-auto w-4/5 rounded-sm border-2 border-slate-900 bg-red-700 py-8 px-4 text-2xl font-bold tracking-widest">
          MAZAT TRANSPORT
        </div>
        <div class="w-5/6 border-2 border-slate-900 bg-sky-700 px-4 py-5 text-xs font-bold tracking-widest">
          FRANCE / INTERNATIONAL
        </div>
        <div class="w-full border-2 border-slate-900 bg-slate-500 px-4 py-5 text-xs font-bold tracking-widest text-slate-950">
          GROUPAGE / CONTENEUR DÉDIÉ
        </div>
      </div>
      <span class="text-xs tracking-widest text-sky-200">
        UN NOUVEL HORIZON. LE MÊME SOIN.
      </span>
    </div>
    <div>
      <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-200">
        Votre projet au-delà des frontières
      </p>
      <h2 class="mb-6 text-3xl font-bold leading-tight md:text-5xl">
        Vos effets personnels
        <br />
        voyagent loin.
        <br />
        <em class="not-italic text-sky-300">Notre exigence reste la même.</em>
      </h2>
      <p class="mb-6 text-slate-300">
        Groupage maritime, conteneur dédié ou accompagnement porte-à-porte :
        nous étudions votre expédition selon le volume, la destination et le
        périmètre retenu.
      </p>
      <a
        class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white no-underline hover:bg-red-800"
        href="/international-maritime/"
      >
        Étudier mon export maritime
      </a>
      <p class="mt-5 text-xs text-slate-300">
        Tarif personnalisé. Itinéraires et prestations selon faisabilité.
      </p>
    </div>
  </div>
</section>
