---
import { Image } from 'astro:assets';
import heroTruck from '../../../assets/images/truck_driving.jpg';
---

<section class="relative isolate overflow-hidden bg-slate-950 text-white">
  <Image
    src={heroTruck}
    alt=""
    aria-hidden="true"
    width={1152}
    height={768}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-slate-950/75" aria-hidden="true"></div>
  <div class="relative mx-auto grid w-11/12 max-w-7xl items-center gap-10 py-10 md:w-5/6 lg:grid-cols-5 lg:gap-12 lg:py-16">
    <div class="lg:col-span-3">
      <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-200">
        Déménagement · Transport · Export maritime
      </p>
      <h1 class="mb-7 text-5xl font-extrabold leading-none tracking-tight md:text-6xl lg:text-7xl">
        Votre déménagement,
        <br />
        <em class="not-italic text-sky-300">notre savoir-faire.</em>
      </h1>
      <p class="mb-7 max-w-xl text-lg leading-relaxed text-slate-300">
        D’une rue à l’autre, d’un pays à l’autre.
        <br />
        Nous accompagnons votre prochain départ avec méthode, protection et
        soin.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          class="inline-flex min-h-13 items-center justify-center rounded-sm border border-red-700 bg-red-700 px-6 py-4 text-sm font-bold text-white no-underline hover:bg-red-800"
          href="/devis/"
        >
          Demander mon devis gratuit
        </a>
        <a
          class="inline-flex min-h-13 items-center justify-center rounded-sm border border-slate-500 bg-transparent px-6 py-4 text-sm font-bold text-white no-underline hover:bg-slate-800"
          href="/formules/"
        >
          Découvrir nos formules
        </a>
      </div>
      <p class="mt-5 text-xs text-slate-400">
        Particuliers & professionnels · Devis sur mesure
      </p>
    </div>
    <div class="mx-auto w-full max-w-md border border-slate-300/40 bg-black/70 p-5 shadow-lg backdrop-blur-sm lg:col-span-2">
      <div class="flex items-center justify-between gap-3 border-b border-slate-300/40 pb-4 text-xs tracking-widest text-slate-100">
        <span>LE SOIN À CHAQUE ÉTAPE</span>
        <span aria-hidden="true">FR / INT.</span>
      </div>
      <img
        class="mx-auto my-4 block h-auto w-full max-w-sm"
        src="/images/mazat-logo.png"
        alt="MAZAT Déménagement Transports, logo au camion rouge"
        width="500"
        height="500"
      />
      <div class="flex items-center justify-between gap-3 border-t border-slate-300/40 pt-4 text-sm text-slate-100">
        <span>
          Votre nouvelle adresse.
          <br />
          <strong class="font-medium text-white">La même exigence.</strong>
        </span>
        <span class="text-xl text-red-400" aria-hidden="true">
          ● ━━━ ●
        </span>
      </div>
    </div>
  </div>
  <div class="mx-auto flex w-11/12 max-w-7xl flex-col gap-3 border-t border-slate-700 py-6 md:w-5/6 md:flex-row md:items-center md:gap-10">
    <span class="text-xs tracking-widest text-slate-400">
      AU DÉPART OU À DESTINATION DE
    </span>
    <p class="m-0 text-white">
      Marseille <i class="not-italic text-slate-500"> / </i> Côte d’Azur{' '}
      <i class="not-italic text-slate-500"> / </i> France{' '}
      <i class="not-italic text-slate-500"> / </i> International
    </p>
  </div>
</section>
