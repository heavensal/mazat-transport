---
import Faq from '../../../components/Faq.astro';
import Reviews from '../../../components/Reviews.astro';
---

<Reviews />
<section class="bg-slate-100 py-16 md:py-24">
  <div class="mx-auto w-11/12 max-w-7xl md:w-5/6">
    <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
      Un projet clair, du début à la fin
    </p>
    <h2 class="mb-8 text-3xl font-bold md:text-5xl">On avance ensemble.</h2>
    <ol class="grid grid-cols-2 gap-8 pt-6 md:grid-cols-4">
      {[
        [
          'Parlons de votre projet',
          'Vos dates, vos adresses, vos biens et vos attentes.',
        ],
        [
          'Précisons les détails',
          'Volume, accès et prestations, avec visite ou vidéo si nécessaire.',
        ],
        [
          'Validons votre devis',
          'Un document détaillé, étudié et validé par MAZAT Transport.',
        ],
        [
          'Préparons votre départ',
          'L’organisation et la protection prévues pour votre déménagement.',
        ],
      ].map(([title, text], index) => (
        <li class="border-t-2 border-slate-300 pt-5">
          <span class="mb-5 block text-sm text-sky-700">0{index + 1}</span>
          <h3 class="mb-2 text-lg font-bold">{title}</h3>
          <p class="m-0 text-sm text-slate-600">{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<Faq />
