          '/services/#emballage',
        ],
      ].map(([title, text, url]) => (
        <a
          class="flex items-center justify-between gap-5 border-t border-slate-300 py-7 no-underline hover:[&_h3]:text-sky-700"
          href={url}
        >
          <span>
            <h3 class="mb-2 text-xl font-bold">{title}</h3>
            <p class="m-0 text-slate-600">{text}</p>
          </span>
          <span class="text-3xl font-light text-sky-700" aria-hidden="true">
            +
          </span>
        </a>
      ))}
