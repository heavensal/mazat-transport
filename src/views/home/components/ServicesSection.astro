<section class="bg-slate-100">
  <div class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
    <div class="mb-10 flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      <div>
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-sky-700">
          Bien plus qu’un transport
        </p>
        <h2 class="m-0 text-3xl font-bold leading-tight md:text-5xl">
          Les bons moyens,
          <br />
          pour chaque situation.
        </h2>
      </div>
      <a
        class="font-bold underline decoration-slate-400 underline-offset-4 hover:text-red-800"
        href="/services/"
