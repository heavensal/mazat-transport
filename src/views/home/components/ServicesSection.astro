          'Protéger, identifier et organiser votre transfert.',
          '/entreprises/',
        ],
        [
          'Garde-meubles',
          'Étudier le volume et la durée de votre stockage.',
          '/services/#stockage',
        ],
        [
          'Monte-meubles & objets lourds',
          'Adapter les moyens aux accès et aux biens.',
          '/services/#acces',
        ],
        [
          'Emballage & protection',
