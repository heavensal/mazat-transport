<section class="border-b border-slate-200 bg-slate-100">
  <div class="mx-auto grid w-11/12 max-w-7xl grid-cols-2 gap-6 py-8 md:w-5/6 md:grid-cols-4 md:py-8">
    {[
      ['Protection maîtrisée', 'Des emballages adaptés à vos biens.'],
      ['Devis personnalisé', 'Un périmètre clair, étudié ensemble.'],
      ['Savoir-faire terrain', 'Des accès aux manutentions spécifiques.'],
      ['France & international', 'Des solutions selon votre destination.'],
    ].map(([title, text]) => (
      <div class="border-l-0 border-slate-300 px-0 md:border-l md:px-6 md:first:border-l-0 md:first:pl-0">
        <h2 class="mb-2 text-base font-bold">{title}</h2>
        <p class="m-0 text-sm text-slate-600">{text}</p>
      </div>
    ))}
  </div>
</section>
