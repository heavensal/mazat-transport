---
const solutions = [
  {
    title: 'Groupage maritime · LCL',
    text: 'Pour quelques cartons et les petits ou moyens volumes. Votre expédition rejoint un groupage ; le calendrier dépend des consolidations. Emballage et inventaire détaillés sont préparés pour le trajet.',
  },
  {
    title: 'Conteneur dédié · FCL',
    text: 'Pour les volumes importants et logements complets. Conteneur de 20 ou 40 pieds selon cubage, itinéraire, faisabilité et conditions de chargement.',
  },
  {
    title: 'Accompagnement porte-à-porte',
    text: 'Collecte, emballage export, opérations portuaires, transport et livraison finale selon le périmètre du contrat, avec les partenaires nécessaires à destination.',
  },
];

---

<section
  class="mx-auto w-11/12 max-w-7xl py-14 md:w-5/6 md:py-20"
  aria-labelledby="international-solutions"
>
  <div class="mb-10 flex flex-col justify-between gap-8 md:flex-row md:items-end">
    <h2 id="international-solutions" class="text-3xl font-bold md:text-5xl">
      Trois solutions.
      <br />
      Un projet sur mesure.
    </h2>
    <p class="max-w-md text-slate-600">
      De l’étude du volume à la remise à destination, retenez un périmètre
      adapté à vos besoins.
    </p>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    {solutions.map(({ title, text }) => (
      <article class="rounded-sm border border-slate-200 p-8">
        <h3 class="mb-3 text-xl font-bold">{title}</h3>
        <p class="text-slate-600">{text}</p>
      </article>
    ))}
  </div>
</section>
