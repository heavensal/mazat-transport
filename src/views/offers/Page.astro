---
import Offers from '../../components/Offers.astro';
import PageHero from '../../components/PageHero.astro';
import type { RegisteredContentPage } from '../../site/pages';

interface Props {
  page: RegisteredContentPage;
}

const { page } = Astro.props;
---

<PageHero page={page} />
<section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
  <Offers full />
  <div
    class="mt-10 max-w-full overflow-x-auto"
    tabindex="0"
    role="region"
    aria-label="Comparatif des formules, défilement horizontal"
  >
    <table class="w-full border-collapse text-sm">
      <caption class="mb-4 text-left font-bold">
        Les principaux niveaux de prise en charge
      </caption>
      <thead class="bg-slate-100">
        <tr>
          <th class="border border-slate-200 p-4 text-left" scope="col">
            Prestation
          </th>
          {['Économique', 'Éco+', 'Standard', 'Premium', 'Luxe / VIP'].map(
            (title) => (
              <th class="border border-slate-200 p-4 text-left" scope="col">
                {title}
              </th>
            ),
          )}
        </tr>
      </thead>
      <tbody>
        {[
          [
            'Chargement, transport, déchargement',
            'Inclus',
            'Inclus',
            'Inclus',
            'Inclus',
            'Inclus',
          ],
          [
            'Protection du mobilier',
            'Usuelle',
            'Renforcée',
            'Selon devis',
            'Adaptée',
            'Adaptée',
          ],
          [
            'Cartons et adhésif',
            'En option',
            'Selon devis',
            'Fragiles selon devis',
            'Adaptés',
            'Adaptés',
          ],
          [
            'Démontage / remontage',
            'Selon devis',
            'Si prévu au devis',
            'Meubles démontables',
            'Inclus selon périmètre',
            'Inclus selon périmètre',
          ],
          [
            'Emballage des fragiles',
            'Par le client',
            'Par le client',
            'Inclus',
            'Inclus',
            'Inclus',
          ],
          [
            'Emballage du contenu',
            'Par le client',
            'Par le client',
            'Hors fragiles : client',
            'Inclus',
            'Inclus',
          ],
          [
            'Remise en place des placards',
            'Non incluse',
            'Non incluse',
            'Non incluse',
            'Selon devis',
            'Incluse',
          ],
          [
            'Nettoyage',
            'Sur demande',
            'Sur demande',
            'Sur demande',
            'Sur demande',
            'Selon zone et devis',
          ],
        ].map((row) => (
          <tr>
            <th
              class="min-w-32 border border-slate-200 p-4 text-left"
              scope="row"
            >
              {row[0]}
            </th>
            {row.slice(1).map((cell) => (
              <td class="min-w-32 border border-slate-200 p-4 text-left">
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-10 border-l-3 border-sky-700 bg-sky-50 px-6 py-5 text-sm text-slate-700">
    Le devis signé précise les inclusions, les quantités et les options. Les
    cartons, penderies, remontages et prestations de nettoyage ne sont pas
    identiques sur toutes les opérations.
  </p>
</section>
