---
import type { ImageMetadata } from 'astro';
import PageHero from '../../components/PageHero.astro';
import type { RegisteredContentPage } from '../../site/pages';
import boxStockage from '../../assets/images/services/box_stockage.jpg';
import furnitureLift from '../../assets/images/services/furniture_lift.jpeg';
import cleaning from '../../assets/images/services/cleaning.jpg';
import protectionBoxes from '../../assets/images/services/protection-boxes.jpg';
import boxesMoving from '../../assets/images/services/boxes-moving.jpg';
import emptyDesks from '../../assets/images/services/empty-desks.jpg';

interface Props {
  page: RegisteredContentPage;
}

interface ServiceCard {
  id: string;
  title: string;
  text: string;
  image?: ImageMetadata;
}

const { page } = Astro.props;

const services: ServiceCard[] = [
  {
    id: 'stockage',
    title: 'Garde-meubles & stockage',
    text: 'Besoin de temps entre deux adresses ? La durée, le volume, la nature du stockage et l’assurance sont étudiés séparément.',
    image: boxStockage,
  },
  {
    id: 'acces',
    title: 'Monte-meubles',
    text: 'Une solution à envisager selon les accès et les autorisations. Une visite technique peut être nécessaire avant de retenir ce matériel.',
    image: furnitureLift,
  },
  {
    id: 'entreprises',
    title: 'Transfert d’entreprise',
    text: 'Bureaux, informatique et archives : organisation de la protection, de l’étiquetage et des manutentions.',
    image: emptyDesks,
  },
  {
    id: 'objets-lourds',
    title: 'Piano & objets lourds',
    text: 'Poids, dimensions, étages et cheminement font l’objet d’une étude technique pour définir le matériel et la manutention adaptés.',
    image: protectionBoxes,
  },
  {
    id: 'emballage',
    title: 'Emballage & cartons',
    text: 'Housses, couvertures, cartons, papier bulle et penderies selon les biens et la formule. Protection spécifique pour les projets export.',
    image: boxesMoving,
  },
  {
    id: 'nettoyage',
    title: 'Nettoyage sur demande',
    text: 'Une prestation optionnelle, selon disponibilité dans la zone et pour le chantier concerné. Le périmètre doit être confirmé au devis.',
    image: cleaning,
  },
];
---

<PageHero page={page} image={boxesMoving} />
<section class="mx-auto w-11/12 max-w-7xl py-16 md:w-5/6 md:py-24">
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      services.map((service) => (
        <article
          class="rounded-lg shadow-sm transition-shadow hover:shadow-lg"
          id={service.id}
        >
          <a
            class="group relative isolate block aspect-square overflow-hidden rounded-lg text-white no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white md:aspect-auto"
            href={`/devis/?service=${service.id}`}
          >
            {
              service.image ? (
                <img
                  alt=""
                  src={service.image.src}
                  width={service.image.width}
                  height={service.image.height}
                  class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
              ) : (
                <div class="absolute inset-0 -z-10 bg-slate-800" aria-hidden="true" />
              )
            }
            <div class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-gray-900/50 to-gray-900/25 p-4 sm:p-6 md:static md:pt-48 lg:pt-64">
              <h2 class="m-0 text-lg font-normal text-white">{service.title}</h2>
              <p class="mt-2 line-clamp-3 text-sm/relaxed text-white/95">{service.text}</p>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</section>
